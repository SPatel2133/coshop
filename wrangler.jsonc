{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coshop",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "ABUSE_LIMITS", "class_name": "AbuseObject" },
    ],
  },
  "migrations": [
    { "tag": "v1-rooms", "new_sqlite_classes": ["RoomObject", "AbuseObject"] },
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Persisted logs carry only the structured outcome lines CoShop emits.
  // Invocation logs and traces stay off: request URLs hold room invites.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": { "enabled": false },
  },
  "env": {
    "portfolio-preview": {
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomObject" },
          { "name": "ABUSE_LIMITS", "class_name": "AbuseObject" },
        ],
      },
      "migrations": [
        { "tag": "v1-rooms", "new_sqlite_classes": ["RoomObject", "AbuseObject"] },
      ],
    },
  },
}
