{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coshop",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "ABUSE_LIMITS", "class_name": "AbuseObject" },
    ],
  },
  "migrations": [
    { "tag": "v1-rooms", "new_sqlite_classes": ["RoomObject", "AbuseObject"] },
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Persisted Worker logs are a separate approval decision; see
  // docs/launch/backend-rollout.md before enabling them in production.
  "observability": { "enabled": false },
  "env": {
    "portfolio-preview": {
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomObject" },
          { "name": "ABUSE_LIMITS", "class_name": "AbuseObject" },
        ],
      },
      "migrations": [
        { "tag": "v1-rooms", "new_sqlite_classes": ["RoomObject", "AbuseObject"] },
      ],
    },
  },
}
