{
  "name": "coshop",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev:cloudflare": "wrangler dev --ip 0.0.0.0 --port 4194",
    "build": "node scripts/build.mjs",
    "deploy:cloudflare": "node scripts/build.mjs && wrangler deploy",
    "test": "node --test tests/phase1-*.test.mjs tests/phase2-*.test.mjs tests/phase3-*.test.mjs tests/shopify.test.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=24"
  }
}
