{
  "name": "coshop",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/build.mjs --assets-only && node server.mjs",
    "start:preview": "node server.mjs",
    "dev:cloudflare": "wrangler dev --ip 0.0.0.0 --port 4194",
    "build": "node scripts/build.mjs",
    "deploy:cloudflare": "node scripts/build.mjs && wrangler deploy",
    "test": "node scripts/build.mjs --assets-only && node --test tests/phase1-*.test.mjs tests/phase2-*.test.mjs tests/phase3-*.test.mjs tests/phase4-*.test.mjs tests/phase5-*.test.mjs tests/phase6-*.test.mjs tests/discussion.test.mjs tests/shopify.test.mjs tests/react-frontend.test.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=24"
  }
}
